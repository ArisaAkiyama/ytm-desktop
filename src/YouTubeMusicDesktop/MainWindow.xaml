                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="6">
                                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                                      Stroke="#8E8E98"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#222228" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Hero Header: 100% Crisp Vector SVG Emblem (No Blurry ICO!) -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Razor-sharp Vector SVG YouTube Music Logo -->
                                <Viewbox Grid.Column="0"
                                         Width="64"
                                         Height="64"
                                         VerticalAlignment="Center"
                                         Margin="0,0,20,0">
                                    <Canvas Width="48" Height="48">
                                        <!-- Outer Red Circle -->
                                        <Ellipse Width="48" Height="48" Fill="#FF0000" />
                                        <!-- Inner White Ring -->
                                        <Path Data="M 24,11 A 13,13 0 1 0 24,37 A 13,13 0 1 0 24,11 Z"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2.4"
                                              Fill="Transparent" />
                                        <!-- Inner Play Triangle -->
                                        <Path Data="M 20.5,17.5 L 30.5,24 L 20.5,30.5 Z"
                                              Fill="#FFFFFF" />
                                    </Canvas>
                                </Viewbox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="YouTube Music Desktop"
                                               Foreground="#FFFFFF"
                                               FontSize="18"
                                               FontWeight="Bold" />
                                    <TextBlock Text="An authentic YouTube Music desktop client engineered with zero AI slop, native dark title bar, 4-layer ad-blocking, Dolby Spatial Audio DSP, and a desktop Dynamic Island."
                                               Foreground="#9A9AA6"
                                               FontSize="12"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Specification Table (Flat Hairline Dividers — NO AI SLOP BOX) -->
                            <StackPanel Margin="0,0,0,24">
                                <Border BorderBrush="#1C1C22" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <TextBlock Text="Application Version" Foreground="#7E7E8A" FontSize="12.5" />
                                        <TextBlock Text="v1.1.0 (Production Release)" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#1C1C22" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <TextBlock Text="Runtime Architecture" Foreground="#7E7E8A" FontSize="12.5" />
                                        <TextBlock Text="Microsoft .NET 8.0 (64-bit WPF Native)" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#1C1C22" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <TextBlock Text="Web Rendering Engine" Foreground="#7E7E8A" FontSize="12.5" />
                                        <TextBlock Text="Microsoft Edge WebView2 (Chromium)" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#1C1C22" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <TextBlock Text="AdBlock &amp; DSP Core" Foreground="#7E7E8A" FontSize="12.5" />
                                        <TextBlock Text="Integrated 4-Layer Engine + Web Audio DSP" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#1C1C22" BorderThickness="0,1,0,1" Padding="0,12">
                                    <Grid>
                                        <TextBlock Text="Developer" Foreground="#7E7E8A" FontSize="12.5" />
                                        <TextBlock Text="Arisa Akiyama" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- GitHub Action Button (Flat Monochromatic) -->
                            <Button HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Click="OnOpenGitHubClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="GhBorder"
                                                Background="#1C1C22"
                                                BorderBrush="#2C2C34"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16,9">
                                            <TextBlock Text="View on GitHub (ArisaAkiyama/ytm-desktop)"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GhBorder" Property="Background" Value="#26262F" />
                                                <Setter TargetName="GhBorder" Property="BorderBrush" Value="#444452" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
