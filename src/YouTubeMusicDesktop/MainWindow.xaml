<Window x:Class="YouTubeMusicDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music"
        Icon="pack://application:,,,/Assets/ytm.ico"
        Width="1180"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="Manual"
        WindowState="Maximized"
        Background="#000000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Title Bar Caption Button Style -->
        <Style x:Key="TitleBarCaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#1E1E22" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#2A2A30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style (Red Hover) -->
        <Style x:Key="TitleBarCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarCaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochromatic Flat Slider Style (Pure White Thumb & Clean Track) -->
        <Style x:Key="MonoSettingsSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24" Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="#2A2A32"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#111114"
                                                        BorderThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochromatic Preset Button Style (Matching Image 2) -->
        <Style x:Key="MonoPresetPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#17171C" />
            <Setter Property="Foreground" Value="#8E8E98" />
            <Setter Property="BorderBrush" Value="#25252C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: NATIVE TITLE BAR (#000000)                                 -->
        <!-- ================================================================= -->
        <Grid Grid.Row="0" Background="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: App Icon & Song / Page Title -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,12,0"
                        IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/ytm.ico"
                       Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
                <TextBlock x:Name="TitleBarTextBlock"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="#D8D8DE"
                           FontSize="12"
                           FontFamily="Segoe UI, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Settings Button (Left of Minimize) + Caption Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- Settings Button (Lucide settings.svg from GitHub) -->
                <Button x:Name="SettingsTitleBarButton"
                        Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Settings"
                        Click="OnSettingsButtonClick">
                    <Grid Width="18" Height="18">
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.32-1.915z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>

                        <!-- White Indicator Dot when Dolby Spatial Audio is active (Monochromatic) -->
                        <Ellipse x:Name="DolbyHeaderIndicatorDot"
                                 Width="6"
                                 Height="6"
                                 Fill="#FFFFFF"
                                 Stroke="#141418"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Minimize Button -->
                <Button Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Minimize"
                        Click="OnMinimizeButtonClick">
                    <Path Data="M 0,5 L 10,5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>

                <!-- Maximize / Restore Button -->
                <Button Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Maximize / Restore"
                        Click="OnMaximizeRestoreButtonClick">
                    <Path x:Name="MaxRestoreIconPath"
                          Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>

                <!-- Close Button -->
                <Button Style="{StaticResource TitleBarCloseBtnStyle}"
                        ToolTip="Close to System Tray"
                        Click="OnCloseCaptionButtonClick">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 1: CONTENT LAYER (WebView2 Player OR Full-Screen Settings)    -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1">
            <!-- 1. Authentic YouTube Music Web View (Zero modifications) -->
            <wv2:WebView2 x:Name="MusicWebView"
                          DefaultBackgroundColor="#030303"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <!-- 2. Full-Screen Settings View (Pure Monochromatic Black & White, Responsive Stretch) -->
            <Grid x:Name="SettingsOverlayGrid"
                  Background="#0E0E11"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- LEFT SIDEBAR: Matching Reference Image 2                  -->
                <!-- ========================================================= -->
                <Border Grid.Column="0"
                        Background="#121215"
                        BorderBrush="#1B1B20"
                        BorderThickness="0,0,1,0"
                        Padding="14,14,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Header: "Settings" (Matching Image 2) -->
                        <TextBlock Grid.Row="0"
                                   Text="Settings"
                                   Foreground="#71717A"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="8,4,0,12" />

                        <!-- Nav Items List -->
                        <StackPanel Grid.Row="1">
                            <!-- Nav 1: Audio & Dolby DSP -->
                            <Border x:Name="NavBtnDolby"
                                    Background="#25252C"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,3"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnNavDolbyClick">
                                <TextBlock x:Name="NavTxtDolby"
                                           Text="Audio &amp; Dolby DSP"
                                           Foreground="#FFFFFF"
                                           FontSize="13"
                                           FontWeight="Medium" />
                            </Border>

                            <!-- Nav 2: Dynamic Island -->
                            <Border x:Name="NavBtnIsland"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,3"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnNavIslandClick">
                                <TextBlock x:Name="NavTxtIsland"
                                           Text="Dynamic Island"
                                           Foreground="#9494A0"
                                           FontSize="13"
                                           FontWeight="Medium" />
                            </Border>

                            <!-- Nav 3: About -->
                            <Border x:Name="NavBtnAbout"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnNavAboutClick">
                                <TextBlock x:Name="NavTxtAbout"
                                           Text="About"
                                           Foreground="#9494A0"
                                           FontSize="13"
                                           FontWeight="Medium" />
                            </Border>
                        </StackPanel>

                        <!-- Bottom Profile/App Info Box (Matching Image 2 Bottom Left) -->
                        <Border Grid.Row="2"
                                Background="#17171C"
                                BorderBrush="#202026"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="pack://application:,,,/Assets/ytm.ico"
                                       Width="26"
                                       Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="YouTube Music"
                                               Foreground="#FFFFFF"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Desktop • v1.1.0"
                                               Foreground="#71717A"
                                               FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- RIGHT CONTENT PANE: Full-Width Stretch & Flat Minimalist  -->
                <!-- ========================================================= -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch"
                          Margin="44,28,52,40">

                        <!-- ================================================= -->
                        <!-- TAB 1: AUDIO & DOLBY DSP CONTENT                  -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="SettingsPanelDolby" Visibility="Visible">
                            <!-- Header with Close Button ✕ (Matching Image 2) -->
                            <Grid Margin="0,0,0,24">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Audio &amp; Dolby DSP"
                                               Foreground="#FFFFFF"
                                               FontSize="20"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Configure 3D soundstage, equalizer parameters, and speaker protection."
                                               Foreground="#8A8A96"
                                               FontSize="12.5"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Close Button ✕ (Matching Image 2 Top-Right) -->
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="28"
                                        Height="28"
                                        Cursor="Hand"
                                        ToolTip="Close (Esc)"
                                        Click="OnCloseSettingsButtonClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="6">
                                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                                      Stroke="#8E8E98"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#222228" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Sub-Heading: Spatial Audio Engine -->
                            <TextBlock Text="Spatial Audio Engine"
                                       Foreground="#E2E2E8"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Configure hardware-accelerated soundstage enhancement."
                                       Foreground="#7A7A86"
                                       FontSize="12"
                                       Margin="0,0,0,12" />

                            <!-- Master Switch Row (Flat & Clean — No Heavy Card Box) -->
                            <Border BorderBrush="#1C1C22"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,16"
                                    Margin="0,0,0,22"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnDolbyMasterToggleClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Enable Dolby Spatial Audio"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Activates real-time 3D soundstage widening, equalizer curves, and dynamic volume leveling."
                                                   Foreground="#82828C"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <!-- Monochromatic Toggle Switch -->
                                    <Border x:Name="DolbyToggleTrack"
                                            Grid.Column="1"
                                            Width="46"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="#FFFFFF"
                                            VerticalAlignment="Center"
                                            Padding="3">
                                        <Ellipse x:Name="DolbyToggleThumb"
                                                 Width="18"
                                                 Height="18"
                                                 Fill="#121215"
                                                 HorizontalAlignment="Right" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Sub-Heading: Target Device -->
                            <TextBlock Text="Target Device Optimization"
                                       Foreground="#E2E2E8"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Select your audio output so the equalizer applies appropriate frequency limits and acoustic models."
                                       Foreground="#7A7A86"
                                       FontSize="12"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Headphones Card -->
                                <Border x:Name="CardHeadphones"
                                        Grid.Column="0"
                                        Background="#1E1E24"
                                        BorderBrush="#484854"
                                        BorderThickness="1.2"
                                        CornerRadius="6"
                                        Padding="16,13"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnDeviceHeadphonesClick">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="HeadphoneIconPath"
                                                          Data="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"
                                                          Stroke="#FFFFFF"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="HeadphoneTitleText"
                                                       Text="Headphones / TWS"
                                                       Foreground="#FFFFFF"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Delivers full 3D binaural surround sound and rich, deep sub-bass frequencies."
                                                   Foreground="#8E8E98"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Laptop Speakers Card -->
                                <Border x:Name="CardLaptopSpeakers"
                                        Grid.Column="2"
                                        Background="#141418"
                                        BorderBrush="#222227"
                                        BorderThickness="1.2"
                                        CornerRadius="6"
                                        Padding="16,13"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnDeviceLaptopClick">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="LaptopIconPath"
                                                          Data="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"
                                                          Stroke="#82828C"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="LaptopTitleText"
                                                       Text="Laptop Speakers"
                                                       Foreground="#8E8E98"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Enhances vocal articulation with built-in anti-clipping filter to protect small speakers."
                                                   Foreground="#8E8E98"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Sub-Heading: Sound Profile Preset -->
                            <TextBlock Text="Sound Profile Preset"
                                       Foreground="#E2E2E8"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Choose a tuned acoustic signature for your music genre."
                                       Foreground="#7A7A86"
                                       FontSize="12"
                                       Margin="0,0,0,12" />

                            <!-- Monochromatic Segmented Preset Group -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="PresetMusicBtn" Content="Music (Balanced)" Style="{StaticResource MonoPresetPillStyle}" Click="OnPresetMusicClick" />
                                <Button x:Name="PresetCinemaBtn" Content="Cinema 3D" Style="{StaticResource MonoPresetPillStyle}" Click="OnPresetCinemaClick" />
                                <Button x:Name="PresetBassBtn" Content="Bass Boost" Style="{StaticResource MonoPresetPillStyle}" Click="OnPresetBassClick" />
                                <Button x:Name="PresetVocalBtn" Content="Vocal Clarity" Style="{StaticResource MonoPresetPillStyle}" Click="OnPresetVocalClick" />
                                <Button x:Name="PresetDynamicBtn" Content="Dynamic" Style="{StaticResource MonoPresetPillStyle}" Click="OnPresetDynamicClick" />
                            </StackPanel>

                            <!-- Sub-Heading: Custom Equalizer Sliders -->
                            <TextBlock Text="Custom Equalizer &amp; Soundstage"
                                       Foreground="#E2E2E8"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Fine-tune your acoustic parameters in real time."
                                       Foreground="#7A7A86"
                                       FontSize="12"
                                       Margin="0,0,0,14" />

                            <!-- Flat Equalizer Slider Rows (NO AI SLOP BOX) -->
                            <StackPanel Margin="0,0,0,8">
                                <!-- Slider 1: 3D Surround Width -->
                                <Border BorderBrush="#1C1C22" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="3D Spatial Width" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text=" • Expands the soundstage outside your head" Foreground="#7A7A86" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="SurroundValueText" Text="70%" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider x:Name="SurroundSlider"
                                                Style="{StaticResource MonoSettingsSliderStyle}"
                                                Value="70"
                                                ValueChanged="OnDspSliderValueChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Slider 2: Bass Enhancer -->
                                <Border BorderBrush="#1C1C22" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Bass Depth &amp; Warmth" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text=" • Round, deep sub-frequencies" Foreground="#7A7A86" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="BassValueText" Text="65%" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider x:Name="BassSlider"
                                                Style="{StaticResource MonoSettingsSliderStyle}"
                                                Value="65"
                                                ValueChanged="OnDspSliderValueChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Slider 3: Vocal Clarity -->
                                <Border BorderBrush="#1C1C22" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Vocal Clarity" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text=" • Sharpens vocal presence &amp; high-frequency sheen" Foreground="#7A7A86" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="ClarityValueText" Text="60%" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider x:Name="ClaritySlider"
                                                Style="{StaticResource MonoSettingsSliderStyle}"
                                                Value="60"
                                                ValueChanged="OnDspSliderValueChanged" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- TAB 2: DYNAMIC ISLAND CONTENT                     -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="SettingsPanelIsland" Visibility="Collapsed">
                            <Grid Margin="0,0,0,24">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Island on Desktop"
                                               Foreground="#FFFFFF"
                                               FontSize="20"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Floating desktop media controller with 60/120 FPS VSync Shared-Element Morphing."
                                               Foreground="#8A8A96"
                                               FontSize="12.5"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Close Button ✕ -->
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="28"
                                        Height="28"
                                        Cursor="Hand"
                                        ToolTip="Close (Esc)"
                                        Click="OnCloseSettingsButtonClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="6">
                                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                                      Stroke="#8E8E98"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#222228" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Master Toggle Row (Flat) -->
                            <Border BorderBrush="#1C1C22"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,16"
                                    Margin="0,0,0,20"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnIslandMasterToggleClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Enable Dynamic Island on Desktop"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="When YouTube Music is minimized, float a compact playback capsule at the top of your desktop."
                                                   Foreground="#82828C"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <!-- Monochromatic Switch -->
                                    <Border x:Name="IslandToggleTrack"
                                            Grid.Column="1"
                                            Width="46"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="#FFFFFF"
                                            VerticalAlignment="Center"
                                            Padding="3">
                                        <Ellipse x:Name="IslandToggleThumb"
                                                 Width="18"
                                                 Height="18"
                                                 Fill="#121215"
                                                 HorizontalAlignment="Right" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Features List (Flat clean rows) -->
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="Desktop Behavior"
                                           Foreground="#FFFFFF"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="• Desktop-Only Visibility: The Dynamic Island monitors window Z-Order in real-time. It only appears when you are looking at your Windows Desktop ('Show Desktop') and automatically hides whenever you open Edge, Chrome, or any application window."
                                           Foreground="#9494A0"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="• VSync Spring Morphing: Hover your mouse cursor over the pill to smoothly morph it from a compact capsule (210×36) into an expanded media card (390×172) featuring album art, live 5-bar equalizer visualizer, interactive seek bar, and transport controls."
                                           Foreground="#9494A0"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="• Silent Background Mode: When disabled, closing or minimizing the app plays audio silently in the Windows System Tray without showing the floating desktop pill."
                                           Foreground="#7A7A86"
                                           FontSize="11.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- TAB 3: ABOUT CONTENT (FLAT & CRISP VECTOR SVG)    -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="SettingsPanelAbout" Visibility="Collapsed">
                            <!-- Header with Close Button ✕ -->
                            <Grid Margin="0,0,0,24">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="About"
                                               Foreground="#FFFFFF"
                                               FontSize="20"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Application information and project specifications."
                                               Foreground="#8A8A96"
                                               FontSize="12.5"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Close Button ✕ -->
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="28"
                                        Height="28"
