<Window x:Class="YouTubeMusicDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music"
        Icon="pack://application:,,,/Assets/ytm.ico"
        Width="1140"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="Manual"
        WindowState="Maximized"
        Background="#030303"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Title Bar Standard Button Style (Settings, Minimize, Maximize) -->
        <Style x:Key="TitleBarCaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D4D4DC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#1F1F26" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#2C2C36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style (Red Hover) -->
        <Style x:Key="TitleBarCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarCaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" Background="#030303">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Native Dark Header Bar (#030303) -->
        <Grid Grid.Row="0" Background="#030303">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: App Icon & Dynamic Song Title -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,12,0"
                        IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/ytm.ico"
                       Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
                <TextBlock x:Name="TitleBarTextBlock"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="#E2E2E8"
                           FontSize="12"
                           FontFamily="Segoe UI, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Settings Button (Left of Minimize) + Window Caption Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- 1. Settings & Dolby DSP Button (Lucide settings.svg from GitHub) -->
                <Button x:Name="SettingsTitleBarButton"
                        Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Settings (Dolby Spatial Audio, Dynamic Island &amp; About)"
                        Click="OnSettingsButtonClick">
                    <Grid Width="18" Height="18">
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.32-1.915z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>

                        <!-- Active Indicator Dot when Dolby Spatial Audio is ON -->
                        <Ellipse x:Name="DolbyHeaderIndicatorDot"
                                 Width="6"
                                 Height="6"
                                 Fill="#FF0033"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- 2. Minimize Button -->
                <Button Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Minimize"
                        Click="OnMinimizeButtonClick">
                    <Path Data="M 0,5 L 10,5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>

                <!-- 3. Maximize / Restore Button -->
                <Button Style="{StaticResource TitleBarCaptionBtnStyle}"
                        ToolTip="Maximize / Restore"
                        Click="OnMaximizeRestoreButtonClick">
                    <Path x:Name="MaxRestoreIconPath"
                          Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>

                <!-- 4. Close Button -->
                <Button Style="{StaticResource TitleBarCloseBtnStyle}"
                        ToolTip="Close to System Tray"
                        Click="OnCloseCaptionButtonClick">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Width="10"
                          Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Main YouTube Music WebView2 Surface -->
        <wv2:WebView2 x:Name="MusicWebView"
                      Grid.Row="1"
                      DefaultBackgroundColor="#030303"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    </Grid>
</Window>
