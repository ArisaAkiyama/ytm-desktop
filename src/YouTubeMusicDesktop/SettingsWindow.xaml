<Window x:Class="YouTubeMusicDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="354"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <!-- Fluent Minimalist Slider Style -->
        <Style x:Key="FluentAudioSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="#26262F"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14"
                                                        Height="14"
                                                        CornerRadius="7"
                                                        Background="#FFFFFF">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.45" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Preset Button Style -->
        <Style x:Key="SegmentedPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181820" />
            <Setter Property="Foreground" Value="#9898A2" />
            <Setter Property="BorderBrush" Value="#252530" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Flyout Frame (Windows 11 Fluent Dark Surface) -->
    <Border Margin="8"
            CornerRadius="12"
            Background="#121216"
            BorderBrush="#25252E"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.60" />
        </Border.Effect>

        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               Foreground="#EEEEF2"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="24"
                        Height="24"
                        Cursor="Hand"
                        Click="OnCloseButtonClick"
                        ToolTip="Close Settings">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="5">
                                <Path Data="M 0,0 L 7.5,7.5 M 7.5,0 L 0,7.5"
                                      Stroke="#8A8A96"
                                      StrokeThickness="1.4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBg" Property="Background" Value="#22222B" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 1: Segmented Navigation Bar -->
            <Border Grid.Row="1"
                    Background="#181820"
                    BorderBrush="#22222A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2.5"
                    Margin="0,0,0,14">
                <UniformGrid Columns="3">
                    <!-- Tab 0: Dolby Audio -->
                    <Border x:Name="TabBtnDolby"
                            CornerRadius="6"
                            Background="#272733"
                            Padding="0,6"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnTabDolbyClick">
                        <TextBlock x:Name="TabTxtDolby"
                                   Text="Dolby Audio"
                                   Foreground="#FFFFFF"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Tab 1: Dynamic Island -->
                    <Border x:Name="TabBtnIsland"
                            CornerRadius="6"
                            Background="Transparent"
                            Padding="0,6"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnTabIslandClick">
                        <TextBlock x:Name="TabTxtIsland"
                                   Text="Dynamic Island"
                                   Foreground="#8E8E98"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Tab 2: About -->
                    <Border x:Name="TabBtnAbout"
                            CornerRadius="6"
                            Background="Transparent"
                            Padding="0,6"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnTabAboutClick">
                        <TextBlock x:Name="TabTxtAbout"
                                   Text="About"
                                   Foreground="#8E8E98"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />
                    </Border>
                </UniformGrid>
            </Border>

            <!-- ============================================================= -->
            <!-- PANEL 1: DOLBY AUDIO (Zero AI-Slop, Clean Hierarchy)          -->
            <!-- ============================================================= -->
            <StackPanel x:Name="PanelDolby" Grid.Row="2" Visibility="Visible">
                <!-- Master Toggle Row -->
                <Grid Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="OnDolbyMasterToggleClick">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dolby Spatial Audio"
                                   Foreground="#FFFFFF"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Immersive 3D soundstage &amp; studio equalizer"
                                   Foreground="#7E7E8A"
                                   FontSize="10.5"
                                   Margin="0,1.5,0,0" />
                    </StackPanel>

                    <!-- iOS/Fluent Toggle Switch -->
                    <Border x:Name="DolbyToggleTrack"
                            Grid.Column="1"
                            Width="38"
                            Height="21"
                            CornerRadius="10.5"
                            Background="#272730"
                            VerticalAlignment="Center"
                            Padding="2.5">
                        <Ellipse x:Name="DolbyToggleThumb"
                                 Width="16"
                                 Height="16"
                                 Fill="#FFFFFF"
                                 HorizontalAlignment="Left" />
                    </Border>
                </Grid>

                <!-- Thin Divider -->
                <Rectangle Height="1" Fill="#1E1E26" Margin="0,0,0,12" />

                <!-- Controls Wrapper (Dims gracefully when Dolby is OFF) -->
                <StackPanel x:Name="DolbyControlsArea">
                    <!-- Output Device Segmented Switch -->
                    <TextBlock Text="Output Device"
                               Foreground="#8E8E9C"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Margin="0,0,0,5" />

                    <Border Background="#16161D"
                            BorderBrush="#22222A"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="2"
                            Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <!-- Headphones Option -->
                            <Border x:Name="CardHeadphones"
                                    CornerRadius="5"
                                    Background="#282834"
                                    Padding="0,6.5"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnDeviceHeadphonesClick">
                                <TextBlock x:Name="TxtHeadphones"
                                           Text="🎧  Headphones / TWS"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Laptop Speakers Option -->
                            <Border x:Name="CardLaptopSpeakers"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    Padding="0,6.5"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnDeviceLaptopClick">
                                <TextBlock x:Name="TxtLaptopSpeakers"
                                           Text="💻  Laptop Speakers"
                                           Foreground="#8E8E9A"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- Sound Profile Presets (4 symmetrical buttons in 1 row) -->
                    <TextBlock Text="Sound Profile"
                               Foreground="#8E8E9C"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Margin="0,0,0,5" />

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Button x:Name="PresetBalancedBtn" Content="Balanced" Style="{StaticResource SegmentedPresetButtonStyle}" Margin="0,0,3,0" Click="OnPresetBalancedClick" />
                        <Button x:Name="PresetCinemaBtn" Content="Cinema" Style="{StaticResource SegmentedPresetButtonStyle}" Margin="2,0,2,0" Click="OnPresetCinemaClick" />
                        <Button x:Name="PresetBassBtn" Content="Bass" Style="{StaticResource SegmentedPresetButtonStyle}" Margin="2,0,2,0" Click="OnPresetBassClick" />
                        <Button x:Name="PresetVocalBtn" Content="Vocal" Style="{StaticResource SegmentedPresetButtonStyle}" Margin="3,0,0,0" Click="OnPresetVocalClick" />
                    </UniformGrid>

                    <!-- Sliders (Clean, Unboxed, Fluent Style) -->
                    <StackPanel Margin="0,0,0,2">
                        <!-- Slider 1: Spatial Soundstage -->
                        <Grid Margin="0,0,0,1">
                            <TextBlock Text="Spatial Soundstage" Foreground="#C6C6D0" FontSize="11" />
                            <TextBlock x:Name="SurroundValueText" Text="70%" Foreground="#8C8C9A" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="SurroundSlider"
                                Style="{StaticResource FluentAudioSliderStyle}"
                                Value="70"
                                Margin="0,0,0,8"
                                ValueChanged="OnDspSliderValueChanged" />

                        <!-- Slider 2: Bass Presence -->
                        <Grid Margin="0,0,0,1">
                            <TextBlock Text="Bass Presence" Foreground="#C6C6D0" FontSize="11" />
                            <TextBlock x:Name="BassValueText" Text="65%" Foreground="#8C8C9A" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="BassSlider"
                                Style="{StaticResource FluentAudioSliderStyle}"
                                Value="65"
                                Margin="0,0,0,8"
                                ValueChanged="OnDspSliderValueChanged" />

                        <!-- Slider 3: Vocal Clarity -->
                        <Grid Margin="0,0,0,1">
                            <TextBlock Text="Vocal Clarity" Foreground="#C6C6D0" FontSize="11" />
                            <TextBlock x:Name="ClarityValueText" Text="60%" Foreground="#8C8C9A" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ClaritySlider"
                                Style="{StaticResource FluentAudioSliderStyle}"
                                Value="60"
                                ValueChanged="OnDspSliderValueChanged" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ============================================================= -->
            <!-- PANEL 2: DYNAMIC ISLAND                                       -->
            <!-- ============================================================= -->
            <StackPanel x:Name="PanelIsland" Grid.Row="2" Visibility="Collapsed">
                <!-- Master Toggle Row -->
                <Grid Margin="0,2,0,14" Cursor="Hand" MouseLeftButtonUp="OnIslandMasterToggleClick">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dynamic Island on Desktop"
                                   Foreground="#FFFFFF"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Show interactive capsule when minimized"
                                   Foreground="#7E7E8A"
                                   FontSize="10.5"
                                   Margin="0,1.5,0,0" />
                    </StackPanel>

                    <Border x:Name="IslandToggleTrack"
                            Grid.Column="1"
                            Width="38"
                            Height="21"
                            CornerRadius="10.5"
                            Background="#FF0033"
                            VerticalAlignment="Center"
                            Padding="2.5">
                        <Ellipse x:Name="IslandToggleThumb"
                                 Width="16"
                                 Height="16"
                                 Fill="#FFFFFF"
                                 HorizontalAlignment="Right" />
                    </Border>
                </Grid>

                <Rectangle Height="1" Fill="#1E1E26" Margin="0,0,0,12" />

                <StackPanel Margin="2,0,2,6">
                    <TextBlock Text="• Only appears on 'Show Desktop' so it never blocks active windows or applications."
                               Foreground="#A2A2AD"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Text="• Hover cursor over the pill to view album art, live 5-bar waveform, and track seek bar."
                               Foreground="#A2A2AD"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Text="• When turned OFF, the app minimizes directly to the Windows System Tray."
                               Foreground="#7E7E88"
                               FontSize="10.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================================= -->
            <!-- PANEL 3: ABOUT APPLICATION                                    -->
            <!-- ============================================================= -->
            <StackPanel x:Name="PanelAbout" Grid.Row="2" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,14">
                    <Image Source="pack://application:,,,/Assets/ytm.ico"
                           Width="42"
                           Height="42"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,0,8" />

                    <TextBlock Text="YouTube Music Desktop"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Version 1.1.0 • 64-bit Native"
                               Foreground="#787884"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,10" />

                    <TextBlock Text="Native Windows desktop client for YouTube Music featuring a 4-Layer Ad-Block Engine, Dolby Spatial Audio DSP, and an iPhone-style Dynamic Island."
                               Foreground="#9E9EA8"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="16"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Developed by Arisa Akiyama"
                               Foreground="#787884"
                               FontSize="10.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <!-- Minimalist Outlined Button -->
                    <Button Width="260"
                            Height="32"
                            Cursor="Hand"
                            Click="OnOpenGitHubClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder"
                                        Background="#181820"
                                        BorderBrush="#2A2A34"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <TextBlock Text="Open GitHub Repository"
                                               Foreground="#E2E2E8"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#242430" />
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3D3D4C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
